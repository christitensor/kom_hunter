# Strava and Telegram credentials are configured from the running app itself
# at /settings -- no env vars needed for those.

# Local dev: SQLite file. On Vercel, DATABASE_URL is injected automatically
# by the Neon (Postgres) storage integration and takes priority over this.
DATABASE_PATH=./kom_hunter.db

# How many days ahead to scan for a KOM-worthy window
FORECAST_DAYS=7

# Self-hosted only: how often the in-process scheduler polls (hours).
# Ignored on Vercel, where a Cron Job calls /api/cron/check-segments instead.
CHECK_INTERVAL_HOURS=3

# Vercel only: set this to any random string in the project's Environment
# Variables, matching what /api/cron/check-segments checks incoming crons
# against (Vercel auto-attaches it as the Authorization header for you).
CRON_SECRET=

# Password that gates /settings and its API (Strava/Telegram credentials).
# Required if you're sharing the app's main URL with anyone -- without this
# set, /settings and its API refuse all access (fail closed).
ADMIN_PASSWORD=
