# Strava API app credentials (create one at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Obtain with scripts/get_strava_token.py
STRAVA_REFRESH_TOKEN=

# Telegram bot (create with @BotFather, then message the bot once and run
# scripts/get_telegram_chat_id.py to find your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often to poll the forecast, in hours
CHECK_INTERVAL_HOURS=3

# How many days ahead to scan for a KOM-worthy window
FORECAST_DAYS=7

# SQLite file
DATABASE_PATH=./kom_hunter.db
